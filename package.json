{
  "name": "dsh-git-sentry",
  "version": "0.1.0",
  "type": "module",
  "description": "集中管理本机 Git 项目的 DSH 插件",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toookamak/dsh-git-sentry.git"
  },
  "homepage": "https://github.com/toookamak/dsh-git-sentry",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "git"
  ],
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}